{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "goals", "key_events", "successes", "frictions", "corrections", "outcome"],
  "properties": {
    "summary": {"type": "string", "maxLength": 2000},
    "goals": {"type": "array", "maxItems": 4, "items": {"type": "string", "maxLength": 400}},
    "key_events": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/evidenceItem"}},
    "successes": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/evidenceItem"}},
    "frictions": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/evidenceItem"}},
    "corrections": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/evidenceItem"}},
    "outcome": {"type": "string", "maxLength": 400}
  },
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detail", "evidence_refs"],
      "properties": {
        "detail": {"type": "string", "maxLength": 1200},
        "evidence_refs": {"type": "array", "maxItems": 6, "items": {"type": "string", "maxLength": 64}}
      }
    }
  }
}
