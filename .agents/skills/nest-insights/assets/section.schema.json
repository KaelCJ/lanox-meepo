{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "lead", "findings", "actions", "closing", "confidence"],
  "properties": {
    "title": {"type": "string"},
    "lead": {"type": "string"},
    "findings": {
      "type": "array", "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "detail", "evidence_refs", "confidence"],
        "properties": {
          "title": {"type": "string"}, "detail": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "maxItems": 12},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "actions": {
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "why", "how", "evidence_refs"],
        "properties": {
          "title": {"type": "string"}, "why": {"type": "string"}, "how": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "maxItems": 12}
        }
      }
    },
    "closing": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
