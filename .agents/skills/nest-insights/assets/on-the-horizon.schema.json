{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["title", "intro", "opportunities", "confidence"],
  "properties": {
    "title": {"type": "string"}, "intro": {"type": "string"},
    "opportunities": {"type": "array", "minItems": 2, "maxItems": 4, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "possibility", "getting_started", "copyable_prompt", "evidence_refs"],
      "properties": {"title": {"type": "string"}, "possibility": {"type": "string"}, "getting_started": {"type": "string"}, "copyable_prompt": {"type": "string"}, "evidence_refs": {"$ref": "#/$defs/refs"}}
    }},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "$defs": {"refs": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string"}}}
}
