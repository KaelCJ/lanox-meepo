{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["title", "intro", "categories", "confidence"],
  "properties": {
    "title": {"type": "string"}, "intro": {"type": "string"},
    "categories": {"type": "array", "minItems": 3, "maxItems": 5, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "sample_count", "description", "consequence", "avoid_by", "examples"],
      "properties": {
        "title": {"type": "string"}, "sample_count": {"type": "integer", "minimum": 1}, "description": {"type": "string"}, "consequence": {"type": "string"}, "avoid_by": {"type": "string"},
        "examples": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["detail", "evidence_refs"], "properties": {"detail": {"type": "string"}, "evidence_refs": {"$ref": "#/$defs/refs"}}}}
      }
    }},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "$defs": {"refs": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string"}}}
}
