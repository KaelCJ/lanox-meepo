{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["title", "intro", "wins", "confidence"],
  "properties": {
    "title": {"type": "string"}, "intro": {"type": "string"},
    "wins": {"type": "array", "minItems": 3, "maxItems": 5, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "description", "why_it_worked", "evidence_refs"],
      "properties": {"title": {"type": "string"}, "description": {"type": "string"}, "why_it_worked": {"type": "string"}, "evidence_refs": {"$ref": "#/$defs/refs"}}
    }},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "$defs": {"refs": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string"}}}
}
