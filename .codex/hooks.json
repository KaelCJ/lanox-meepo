{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/session_start.py codex",
            "statusMessage": "Loading workspace context",
            "additionalContextLimit": 0,
            "async": false
          }
        ]
      }
    ]
  }
}
